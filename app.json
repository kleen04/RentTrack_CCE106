{
  "expo": {
    "name": "RentTrack_CCE106",
    "slug": "RentTrack_CCE106",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/RTlogo.png",
    "userInterfaceStyle": "dark",
    "scheme": "renttrack",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/RTlogo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RentTrack to access your photos so you can attach vehicle images."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing"
    ]
  }
}
